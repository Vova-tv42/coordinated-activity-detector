# Generate with: bunx auth secret
AUTH_SECRET=
# Google Cloud Console, OAuth client ID of type "Web application"
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated list of Google accounts that can sign in
ADMIN_EMAILS=
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Random string Telegram sends back in every webhook request, generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS address of the app, used by bun run set-webhook
PUBLIC_URL=
