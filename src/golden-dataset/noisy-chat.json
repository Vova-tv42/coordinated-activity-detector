{
  "sourceName": "Динамо - Шахтар. Онлайн-трансляція",
  "groundTruth": [],
  "messages": [
    {
      "author": "dynamo_fan_kyiv",
      "at": "2026-10-17T19:58:10+03:00",
      "text": "Всім привіт, хто де дивиться матч?"
    },
    {
      "author": "andrii_lviv",
      "at": "2026-10-17T19:58:32+03:00",
      "text": "Я на стадіоні, сектор 23, атмосфера шалена"
    },
    { "author": "bodia", "at": "2026-10-17T19:58:50+03:00", "text": "Вдома з пивом і чипсами" },
    {
      "author": "orest.m",
      "at": "2026-10-17T19:59:15+03:00",
      "text": "Склад вже бачили? Чому Ванат на лавці?"
    },
    {
      "author": "kateryna_v",
      "at": "2026-10-17T19:59:40+03:00",
      "text": "Тренер береже його на другий тайм, мабуть"
    },
    {
      "author": "shakhtar_forever",
      "at": "2026-10-17T20:00:05+03:00",
      "text": "Шахтар сьогодні розносить, ставлю 0:2"
    },
    { "author": "dynamo_fan_kyiv", "at": "2026-10-17T20:00:30+03:00", "text": "Мрій далі" },
    {
      "author": "roman_futbol",
      "at": "2026-10-17T20:01:12+03:00",
      "text": "Пряма трансляція тут, якщо в когось немає підписки https://www.youtube.com/watch?v=Xd8LkP2vQ0a #ДинамоШахтар"
    },
    {
      "author": "sasha_t",
      "at": "2026-10-17T20:02:40+03:00",
      "text": "Дякую, Романе, бо мій канал щось лагає"
    },
    {
      "author": "vlad_k",
      "at": "2026-10-17T20:04:05+03:00",
      "text": "Яка жовта на третій хвилині, суддя сліпий?"
    },
    { "author": "andrii_lviv", "at": "2026-10-17T20:04:20+03:00", "text": "Там чистий фол був" },
    {
      "author": "orest.m",
      "at": "2026-10-17T20:05:33+03:00",
      "text": "Шахтар з перших хвилин тисне"
    },
    {
      "author": "lesia_h",
      "at": "2026-10-17T20:07:10+03:00",
      "text": "Хто пояснить, чому офсайд? Я не зрозуміла"
    },
    {
      "author": "kateryna_v",
      "at": "2026-10-17T20:07:45+03:00",
      "text": "Нападник був на пів кроку попереду останнього захисника"
    },
    { "author": "bodia", "at": "2026-10-17T20:12:01+03:00", "text": "ГОООЛ!!!" },
    { "author": "dynamo_fan_kyiv", "at": "2026-10-17T20:12:04+03:00", "text": "ТАААК!!!" },
    {
      "author": "andrii_lviv",
      "at": "2026-10-17T20:12:07+03:00",
      "text": "Стадіон просто вибухнув!!! Неймовірний удар з-за штрафного!"
    },
    {
      "author": "sasha_t",
      "at": "2026-10-17T20:12:15+03:00",
      "text": "Який гол, просто в девʼятку!"
    },
    { "author": "vlad_k", "at": "2026-10-17T20:12:22+03:00", "text": "Гол!!! 1:0" },
    {
      "author": "roman_futbol",
      "at": "2026-10-17T20:12:40+03:00",
      "text": "Повтор цього шедевру вже є https://www.youtube.com/watch?v=Rt4mN8zQ1pE #ДинамоШахтар"
    },
    {
      "author": "shakhtar_forever",
      "at": "2026-10-17T20:13:02+03:00",
      "text": "Пощастило, воротар послизнувся"
    },
    {
      "author": "orest.m",
      "at": "2026-10-17T20:13:30+03:00",
      "text": "Ну це вже не везіння, це клас"
    },
    {
      "author": "lesia_h",
      "at": "2026-10-17T20:15:20+03:00",
      "text": "Нарешті щось зрозуміле навіть мені"
    },
    {
      "author": "kateryna_v",
      "at": "2026-10-17T20:21:44+03:00",
      "text": "Шахтар зараз змінить схему, ось побачите"
    },
    { "author": "taras_b", "at": "2026-10-17T20:24:10+03:00", "text": "Приєднуюсь, що пропустив?" },
    {
      "author": "bodia",
      "at": "2026-10-17T20:24:35+03:00",
      "text": "Наші забили з штрафного, 1:0"
    },
    { "author": "taras_b", "at": "2026-10-17T20:25:01+03:00", "text": "Ех, саме гол і пропустив" },
    {
      "author": "vlad_k",
      "at": "2026-10-17T20:29:50+03:00",
      "text": "Ще один такий тайм і ми чемпіони"
    },
    {
      "author": "shakhtar_forever",
      "at": "2026-10-17T20:33:15+03:00",
      "text": "Пенальті! Чистий пенальті!"
    },
    {
      "author": "dynamo_fan_kyiv",
      "at": "2026-10-17T20:33:20+03:00",
      "text": "Та який пенальті, він сам упав"
    },
    {
      "author": "andrii_lviv",
      "at": "2026-10-17T20:33:28+03:00",
      "text": "Суддя біжить до монітора VAR"
    },
    {
      "author": "orest.m",
      "at": "2026-10-17T20:33:41+03:00",
      "text": "Зараз скасують, контакту не було"
    },
    {
      "author": "kateryna_v",
      "at": "2026-10-17T20:35:02+03:00",
      "text": "VAR каже пенальті, ну що ж"
    },
    {
      "author": "shakhtar_forever",
      "at": "2026-10-17T20:36:10+03:00",
      "text": "ГОЛ! 1:1, я ж казав!"
    },
    { "author": "sasha_t", "at": "2026-10-17T20:36:18+03:00", "text": "Обідно, але заслужено" },
    {
      "author": "lesia_h",
      "at": "2026-10-17T20:40:30+03:00",
      "text": "Перерва скоро? Піду чай поставлю"
    },
    { "author": "bodia", "at": "2026-10-17T20:46:05+03:00", "text": "Перерва, 1:1, гра рівна" },
    {
      "author": "roman_futbol",
      "at": "2026-10-17T20:47:12+03:00",
      "text": "Статистика першого тайму: удари 6 на 5, володіння 48 на 52 #ДинамоШахтар"
    },
    {
      "author": "taras_b",
      "at": "2026-10-17T20:50:40+03:00",
      "text": "Хто ставив на нічию, вже радіє"
    },
    {
      "author": "vlad_k",
      "at": "2026-10-17T21:03:05+03:00",
      "text": "Другий тайм почався, Ванат виходить!"
    },
    {
      "author": "dynamo_fan_kyiv",
      "at": "2026-10-17T21:03:12+03:00",
      "text": "Нарешті! Зараз буде гол"
    },
    { "author": "andrii_lviv", "at": "2026-10-17T21:11:50+03:00", "text": "Стовп! Ну як так!" },
    { "author": "orest.m", "at": "2026-10-17T21:11:58+03:00", "text": "Сантиметри не вистачило" },
    {
      "author": "kateryna_v",
      "at": "2026-10-17T21:19:30+03:00",
      "text": "Ванат вже двічі мав чудові моменти"
    },
    { "author": "bodia", "at": "2026-10-17T21:27:01+03:00", "text": "ГОООООЛ ВАНАТ!!!" },
    {
      "author": "dynamo_fan_kyiv",
      "at": "2026-10-17T21:27:03+03:00",
      "text": "Я ж казав, що забʼє!!!"
    },
    {
      "author": "sasha_t",
      "at": "2026-10-17T21:27:09+03:00",
      "text": "2:1!!! Головою після кутового!"
    },
    {
      "author": "andrii_lviv",
      "at": "2026-10-17T21:27:15+03:00",
      "text": "Весь сектор стрибає, це щось неймовірне"
    },
    { "author": "lesia_h", "at": "2026-10-17T21:27:40+03:00", "text": "Ура! Навіть чай пролила" },
    {
      "author": "shakhtar_forever",
      "at": "2026-10-17T21:28:20+03:00",
      "text": "Захист знову проспав кутовий"
    },
    {
      "author": "roman_futbol",
      "at": "2026-10-17T21:28:45+03:00",
      "text": "Гол Ваната з усіх ракурсів https://www.youtube.com/watch?v=Pq7wZ3nV5kD #ДинамоШахтар"
    },
    {
      "author": "taras_b",
      "at": "2026-10-17T21:35:10+03:00",
      "text": "Аби тепер дотерпіти до кінця"
    },
    { "author": "vlad_k", "at": "2026-10-17T21:44:02+03:00", "text": "Додали чотири хвилини" },
    { "author": "orest.m", "at": "2026-10-17T21:48:30+03:00", "text": "Фінальний свисток! 2:1!" },
    {
      "author": "dynamo_fan_kyiv",
      "at": "2026-10-17T21:48:35+03:00",
      "text": "Перемога! Всіх вітаю!"
    },
    {
      "author": "kateryna_v",
      "at": "2026-10-17T21:49:10+03:00",
      "text": "Заслужена перемога, другий тайм був за нами"
    },
    {
      "author": "shakhtar_forever",
      "at": "2026-10-17T21:50:02+03:00",
      "text": "Нічого, у кубку відіграємось"
    },
    {
      "author": "andrii_lviv",
      "at": "2026-10-17T21:52:40+03:00",
      "text": "Йду з стадіону без голосу, але щасливий"
    }
  ]
}
